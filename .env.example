# Copy to .env and fill in. See README-BACKEND.md for how to obtain each value.

# Canonical app URL — used anywhere an absolute URL is needed (e.g. the table QR
# codes in src/components/control/table-qr-dialog.tsx). Set this to the real
# deployed domain in staging/production; a QR code baked with "localhost" is
# useless once printed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Postgres connection string. Local Postgres, Neon, or Supabase all work.
# For Supabase specifically: DATABASE_URL is the shared transaction-mode pooler
# (port 6543, ?pgbouncer=true) — used by the running app. DIRECT_URL is the shared
# session-mode pooler (port 5432) — used by prisma.config.ts for CLI/migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/voya?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/voya?schema=public"

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="voya-assets"
CLOUDFLARE_R2_PUBLIC_URL=""
# Optional safety cap (GiB) — uploads are refused once the bucket would exceed this.
# Defaults to 9 (just under R2's 10 GiB/month free tier) if unset.
CLOUDFLARE_R2_MAX_STORAGE_GB="9"
