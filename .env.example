# Copy to .env and fill in. See README-BACKEND.md for how to obtain each value.

# Postgres connection string — local Postgres or a Neon connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/voya?schema=public"

# Cloudflare R2 (S3-compatible object storage)
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="voya-assets"
CLOUDFLARE_R2_PUBLIC_URL=""
# Optional safety cap (GiB) — uploads are refused once the bucket would exceed this.
# Defaults to 9 (just under R2's 10 GiB/month free tier) if unset.
CLOUDFLARE_R2_MAX_STORAGE_GB="9"
